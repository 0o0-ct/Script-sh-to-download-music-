+    printf '  %sURLs procesadas:%s %s\n' "$BOLD" "$NC" "$total"
+    printf '  %sCon éxito:%s       %s\n' "$BOLD" "$NC" "$ok"
+    printf '  %sCon errores:%s     %s\n' "$BOLD" "$NC" "$failed"
+    printf '  %sCanceladas:%s      %s\n' "$BOLD" "$NC" "$skipped"
+    return 0
+}
