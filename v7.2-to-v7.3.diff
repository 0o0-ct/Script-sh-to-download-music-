+            target="$(destination_display)"
+        fi
+        detect_url_type "$url"
+        download_job "$url" "$DETECTED_TYPE" "$DETECTED_COUNT" "$target" || true
+        case "$JOB_STATUS" in
+            ok) ok=$((ok + 1)) ;;
+            cancelled) skipped=$((skipped + 1)) ;;
+            *) failed=$((failed + 1)) ;;
+        esac
+    done
